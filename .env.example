# Public booking calendar URL (Google Calendar appointment page, iframe src)
# Example: https://calendar.app.google/xxxxxxxxxxxx
NEXT_PUBLIC_BOOKING_URL=

# Lead-capture form embed URL (GoHighLevel form, Sites > Forms > embed link).
# Same integration pattern as the booking widget above. The /contact page
# capture section only renders once this is set — leave blank until the
# form is built in GHL.
# Example: https://api.leadconnectorhq.com/widget/form/xxxxxxxxxxxx
NEXT_PUBLIC_CAPTURE_FORM_URL=
