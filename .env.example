# Public booking calendar URL (Google Calendar appointment page, iframe src)
# Example: https://calendar.app.google/xxxxxxxxxxxx
NEXT_PUBLIC_BOOKING_URL=

# Lead-capture form embed URL (GoHighLevel form, Sites > Forms > embed link).
# Same integration pattern as the booking widget above. The /contact page
# capture section only renders once this is set — leave blank until the
# form is built in GHL.
# Example: https://api.leadconnectorhq.com/widget/form/xxxxxxxxxxxx
NEXT_PUBLIC_CAPTURE_FORM_URL=

# PRIMARY path for /reviews#share-feedback delivery — Gmail / Google
# Workspace SMTP. Server-only, never NEXT_PUBLIC_. GMAIL_USER is the
# sending address (e.g. themoderntradesmentor@gmail.com or a Workspace
# address). GMAIL_APP_PASSWORD is a 16-character Google App Password —
# NOT the regular account password. To generate one: the Google Account
# must have 2-Step Verification turned on first, then Google Account ->
# Security -> 2-Step Verification -> App Passwords -> create one for
# "Mail". Both must be set for this path to activate.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Where feedback emails land. Defaults to themoderntradesmentor@gmail.com
# in code if left blank — set this if it should go somewhere else.
FEEDBACK_TO_EMAIL=

# SECONDARY path — only used if GMAIL_USER/GMAIL_APP_PASSWORD above are
# not set. Create a free Resend account (resend.com), generate an API
# key, paste it here.
RESEND_API_KEY=

# The "From" address emails are sent as when using Resend. Resend
# requires a verified sending domain for anything other than their
# shared onboarding address — defaults in code to
# "TMT Feedback Form <onboarding@resend.dev>", which works immediately
# with no domain setup. Once themoderntradesmentor.com is verified with
# Resend, change this to something like
# "TMT Feedback Form <feedback@themoderntradesmentor.com>".
FEEDBACK_FROM_EMAIL=

# TERTIARY path — only used if neither Gmail nor Resend above is set.
# Points at any inbound webhook: a Zapier/Make webhook, a GHL inbound
# webhook built inside GHL, a Slack webhook, etc.
FEEDBACK_WEBHOOK_URL=

# Verified Google Business Profile review link (the "write a review"
# URL from the GBP listing itself, NOT guessed or constructed). The
# /reviews "Leave a Google Review" button only renders once this is set.
# Example: https://search.google.com/local/writereview?placeid=xxxxxxxxxxxx
NEXT_PUBLIC_GOOGLE_REVIEW_URL=
