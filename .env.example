# Public booking calendar URL (Google Calendar appointment page, iframe src)
# Example: https://calendar.app.google/xxxxxxxxxxxx
NEXT_PUBLIC_BOOKING_URL=

# Lead-capture form embed URL (GoHighLevel form, Sites > Forms > embed link).
# Same integration pattern as the booking widget above. The /contact page
# capture section only renders once this is set — leave blank until the
# form is built in GHL.
# Example: https://api.leadconnectorhq.com/widget/form/xxxxxxxxxxxx
NEXT_PUBLIC_CAPTURE_FORM_URL=

# Where /reviews#share-feedback submissions get delivered. Server-only —
# never NEXT_PUBLIC_, this endpoint must not be callable directly by a
# browser. Point it at any inbound webhook: a Zapier/Make webhook, a GHL
# inbound webhook built inside GHL, a Slack webhook, etc. Until this is
# set, the feedback form returns an honest "not configured" error instead
# of a fake success message — it does not silently drop submissions.
FEEDBACK_WEBHOOK_URL=

# Verified Google Business Profile review link (the "write a review"
# URL from the GBP listing itself, NOT guessed or constructed). The
# /reviews "Leave a Google Review" button only renders once this is set.
# Example: https://search.google.com/local/writereview?placeid=xxxxxxxxxxxx
NEXT_PUBLIC_GOOGLE_REVIEW_URL=
